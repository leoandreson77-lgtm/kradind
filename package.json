{
  "name": "kradind-adventures-workspace",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/kradind-adventures run dev",
    "preinstall": "node -e \"const fs = require('fs'); ['package-lock.json', 'yarn.lock'].forEach(f => fs.existsSync(f) && fs.unlinkSync(f));\"",
    "build": "pnpm --filter @workspace/kradind-adventures run build",
    "start": "pnpm --filter @workspace/kradind-adventures run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}

